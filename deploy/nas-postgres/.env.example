# Replace with dedicated NAS-local absolute paths. No SMB / NFS database path.
POSTGRES_DATA_DIR=/REPLACE_WITH_NAS_LOCAL_PATH/nas-postgres/data
# Reference only. backup.sh takes an explicit BACKUP_DIR.
POSTGRES_BACKUP_DIR=/REPLACE_WITH_NAS_BACKUP_PATH/nas-postgres
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm
# Use THREE DIFFERENT passwords, at least 32 characters, preferably hex / letters / digits.
# Avoid $, # and quotes here to keep GUI .env editing simple.
POSTGRES_PASSWORD=
ISLAND_DB_PASSWORD=
MIND_DB_PASSWORD=
