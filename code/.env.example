# Default Mac development: existing Wrangler D1 / SQLite saves stay in .wrangler/state.
ISLAND_DATABASE_PROVIDER=d1

# Future NAS Node deployment / separate local PostgreSQL development:
# ISLAND_DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://island_app:URL_ENCODED_PASSWORD@nas-postgres:5432/unnamed_island
# Never use NEXT_PUBLIC_ for credentials. Changing provider does not migrate data.
