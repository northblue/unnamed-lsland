// Keep model fields aligned with ../schema.prisma; migrations are provider-specific.
generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/postgresql"
}

datasource db {
  provider = "postgresql"
}

// Initial persistence model, not a completed authentication system.
model User {
  id        String     @id @default(cuid())
  name      String?
  email     String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saves     GameSave[]
}

model GameSave {
  id        String   @id @default(cuid())
  userId    String
  slot      Int      @default(1)
  version   Int      @default(1)
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
}

model Island {
  id            String     @id
  name          String     @default("无名岛")
  wood          Int        @default(0)
  stone         Int        @default(0)
  playerX       Float      @default(0)
  playerZ       Float      @default(4)
  resourceState Json
  revision      Int        @default(0)
  updatedAt     DateTime   @updatedAt
  // Save inventory and buildings in one atomic update, without interactive transactions.
  buildings     Json
  catches       Json       @default("{}")
  pond          Json       @default("{}")
}
